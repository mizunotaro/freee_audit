# =============================================================================
# freee_audit Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PoC/Dev: SQLite | Production: PostgreSQL
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="freee_audit"
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
APP_VERSION="1.0.0"
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Authentication (REQUIRED - App will fail to start if not set)
# -----------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="<generate-32-byte-hex-string>"
CSRF_SECRET="<generate-32-byte-hex-string>"
BCRYPT_ROUNDS="12"

# Session Policy (optional overrides)
# SESSION_MAX_CONCURRENT="5"
# SESSION_MAX_AGE_MS="86400000"
# SESSION_IDLE_TIMEOUT_MS="1800000"
# SESSION_REFRESH_WINDOW_MS="3600000"
# SESSION_ENFORCE_SINGLE="false"

# -----------------------------------------------------------------------------
# Encryption (REQUIRED - AES-256-GCM)
# -----------------------------------------------------------------------------
# 64-char hex string (32 bytes). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="<generate-32-byte-hex-string>"

# Secure storage key (optional, falls back to ENCRYPTION_KEY)
# SECURE_STORAGE_KEY="<generate-32-byte-hex-string>"

# Audit log integrity (32+ char secret for tamper-proof hash chain)
AUDIT_HASH_SECRET="<generate-32-byte-secret>"

# Cookie domain (optional, for production)
# COOKIE_DOMAIN=".example.com"

# -----------------------------------------------------------------------------
# freee API Integration
# -----------------------------------------------------------------------------
FREEE_CLIENT_ID="your-freee-client-id"
FREEE_CLIENT_SECRET="your-freee-client-secret"
FREEE_REDIRECT_URI="http://localhost:3000/api/freee/callback"
# Set to "true" for development without real freee credentials
FREEE_MOCK_MODE="true"

# -----------------------------------------------------------------------------
# AI Provider Configuration
# -----------------------------------------------------------------------------
# Default provider: openai | claude | gemini | openrouter | deepseek | kimi | qwen | groq | azure | aws | gcp | custom
AI_PROVIDER="openai"

# Set to "true" to use mock AI responses (no API calls, for development)
AI_MOCK_MODE="true"

# AI generation parameters
AI_TEMPERATURE="0.1"
AI_MAX_TOKENS="4096"

# AI timeout and retries
AI_TIMEOUT="30000"
AI_RETRIES="0"

# Fallback chain (comma-separated provider list)
# AI_PROVIDERS="openai,claude,gemini"

# -----------------------------------------------------------------------------
# AI API Keys (at least one required when AI_MOCK_MODE=false)
# -----------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-nano"

# Anthropic Claude
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-sonnet-4-6-20250514"

# Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash-preview-05-20"

# OpenRouter (multi-model routing)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-5.4-nano"
OPENROUTER_ZDR="true"
OPENROUTER_SITE_URL=""

# Custom LLM (OpenAI-compatible endpoint, e.g., Ollama)
# CUSTOM_LLM_BASE_URL="http://localhost:11434/v1"

# -----------------------------------------------------------------------------
# Slack Notifications (optional)
# -----------------------------------------------------------------------------
SLACK_BOT_TOKEN=""
SLACK_CHANNEL_ID=""

# -----------------------------------------------------------------------------
# Box Storage (production only)
# -----------------------------------------------------------------------------
BOX_CLIENT_ID=""
BOX_CLIENT_SECRET=""
BOX_ENTERPRISE_ID=""
BOX_REDIRECT_URI=""
BOX_MOCK_MODE="true"

# -----------------------------------------------------------------------------
# OCR Configuration
# -----------------------------------------------------------------------------
# NDLOCR (Docker-based)
NDLOCR_DOCKER_ENDPOINT="http://localhost:8002"

# YomiTaku
YOMITOKU_ENABLED="false"
YOMITOKU_API_URL="http://localhost:8001"
YOMITOKU_LITE_MODE="false"

# -----------------------------------------------------------------------------
# Python Calculation Service
# -----------------------------------------------------------------------------
PYTHON_SERVICE_URL="http://localhost:8000"
ENABLE_PYTHON_SERVICE="true"
CALCULATION_TIMEOUT="30000"
CALCULATION_RETRIES="3"

# -----------------------------------------------------------------------------
# R Statistical Service
# -----------------------------------------------------------------------------
R_SERVICE_URL="http://localhost:8001"
ENABLE_R_SERVICE="true"

# Fallback to TypeScript implementations when services are down
FALLBACK_TO_TYPESCRIPT="true"

# -----------------------------------------------------------------------------
# Storage Configuration
# -----------------------------------------------------------------------------
STORAGE_LOCAL_BASE_PATH="./data/storage"
STORAGE_LOCAL_TEMP_PATH="./data/temp"

# -----------------------------------------------------------------------------
# Secret Management Provider
# -----------------------------------------------------------------------------
# Provider: local | env | gcp | aws | azure | onepassword
SECRET_PROVIDER="env"
SECRET_PREFIX="api-keys"
LOCAL_SECRETS_PATH="./secrets.json"

# Cloud provider configs (optional)
# GCP_PROJECT_ID=""
# AWS_REGION=""
# AZURE_KEYVAULT_URL=""
# ONEPASSWORD_CONNECT_HOST=""
# ONEPASSWORD_CONNECT_TOKEN=""
# ONEPASSWORD_VAULT_ID=""

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW_MS="60000"

# Redis for distributed rate limiting (optional)
# REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# Scheduled Jobs
# -----------------------------------------------------------------------------
WEEKLY_AUDIT_ENABLED="true"
MONTHLY_AUDIT_ENABLED="true"
AUDIT_CONCURRENCY="5"

# -----------------------------------------------------------------------------
# Caching
# -----------------------------------------------------------------------------
CACHE_TTL_EXCHANGE_RATE="3600000"
CACHE_TTL_KPI="1800000"

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL="debug"
